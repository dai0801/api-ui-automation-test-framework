# ==================================================
# Public example environment variables
# ==================================================
#
# Copy this file to .env for local use:
#
#   Copy-Item .env.example .env
#
# Never commit the real .env file.
# ==================================================


# --------------------------------------------------
# Login credentials
# --------------------------------------------------

TEST_LOGIN_ACCOUNT=""
TEST_LOGIN_PASSWORD=""


# --------------------------------------------------
# Public/demo URLs
# --------------------------------------------------

# Base URL used by API tests
TEST_BASE_URL="https://example.invalid"

# Resident-list API path
TEST_DWELLER_API="/api/v1/residents"

# Login page URL
TEST_LOGIN_URL="https://example.invalid/login"

# Target business application URL
TEST_TARGET_APP_URL="https://example.invalid/business-app"

# Keyword used to identify the target application's URL
TEST_TARGET_APP_URL_KEYWORD="business-app"

# Invite/test-flow page URL
TEST_INVITE_URL="https://example.invalid/invite"


# --------------------------------------------------
# Login / target-system UI text
# --------------------------------------------------

TEST_PASSWORD_LOGIN_TEXT="密码登录"
TEST_LOGIN_BUTTON_TEXT="立即登录"
TEST_LOGIN_SUCCESS_TEXT="用户中心"

# Python regular-expression strings
TEST_LOGIN_SUCCESS_URL_PATTERN=".*/main.*"
TEST_TARGET_SYSTEM_NAME="业务管理系统"
TEST_TARGET_SYSTEM_URL_PATTERN=".*/business-system.*"

# Target application discovery
# Multiple values are comma-separated
TEST_TARGET_APP_KEYWORDS="业务系统,测试系统"

# Menu used to trigger a read-only API request
TEST_TARGET_MENU_TEXT="居民管理"


# --------------------------------------------------
# API authentication
# --------------------------------------------------

# These may be left blank in the local .env.
# When missing or expired, the test framework can try to
# obtain fresh temporary values through the UI login flow.
TEST_AUTH_TOKEN=""
TEST_APP_CODE=""

# Keyword used to identify target API requests in browser traffic
TEST_API_REQUEST_PATH_KEYWORD="/api/"


# --------------------------------------------------
# API test data / business parameters
# --------------------------------------------------

TEST_DWELLER_NAME=""

TEST_API_QUERY_SCENE="resident_list"
TEST_API_GROUP_TYPE="1"
TEST_API_RANK="0"

TEST_NONEXISTENT_DWELLER_NAME="AUTO_TEST_NOT_EXIST_999999"


# --------------------------------------------------
# Statistics UI
# --------------------------------------------------

TEST_STATISTICS_TASK_NAME="测试任务"
TEST_STATISTICS_MENU_TEXT="统计分析"
TEST_PHONE_STATISTICS_TEXT="任务统计"

# Python regular-expression string
TEST_STATISTICS_URL_PATTERN=".*/statistics/.*"

TEST_TASK_TIME_TEXT="任务时间"
TEST_DETAIL_BUTTON_TEXT="详情"

# Multiple values use | as separator
TEST_DETAIL_TITLE_KEYWORDS="任务汇总详细|任务汇总详情"

TEST_NAME_PLACEHOLDER="请输入姓名"
TEST_PHONE_PLACEHOLDER="请输入电话"
TEST_SEARCH_BUTTON_TEXT="搜索"
TEST_EMPTY_DATA_TEXT="暂无数据"

# Multiple values use | as separator
TEST_CORE_METRICS="呼叫人数|接通人数|接通率"
TEST_CHART_TITLES="接通结果分类|未接通结果分类"
TEST_DETAIL_BASIC_FIELDS="姓名：|电话：|通话时长：|接通结果分类|搜索"
TEST_DETAIL_REQUIRED_COLUMNS="姓名|手机号码|通话时长|呼叫时间|拨打次数|呼叫状态|接通结果分类|短信提醒"


# --------------------------------------------------
# Authorized invite / live-call flow
# --------------------------------------------------

# Public repository default sample path.
# Do not put real company templates or personal data in Git.
TEST_INVITE_EXCEL="test_data/invite_sample.xlsx"

TEST_INVITE_TEMPLATE_NAME="测试邀约模板"

TEST_INVITE_PAGE_TEXT="居民邀约"
TEST_NOTICE_SECTION_TEXT="选择通知内容"
TEST_TEMPLATE_INPUT_PLACEHOLDER="请选择电话模板"

# Generic selector for editable notice content
TEST_NOTICE_CONTENT_SELECTOR="form [contenteditable='true']"

TEST_CONFIRM_PAGE_TEXT="确认邀约居民"
TEST_UPLOAD_TEXT="点击上传"
TEST_IMPORT_RESULT_TITLE="居民信息导入结果"
TEST_SYSTEM_PROMPT_TITLE="系统提示"

TEST_NEXT_BUTTON_TEXT="下一步"
TEST_CLOSE_BUTTON_TEXT="关闭"
TEST_EXECUTE_BUTTON_TEXT="执行"
TEST_TASK_SUCCESS_TEXT="任务创建成功"

# Internal API endpoint fragments must be configured locally.
TEST_FILTER_API_KEYWORD="/api/invite/filter"
TEST_EXECUTE_API_KEYWORD="/api/call/create"


# --------------------------------------------------
# Runtime safety
# --------------------------------------------------

# Normal regression should normally use 0.
KEEP_BROWSER_SECONDS=0

# Keep false by default.
# Only the separately isolated live-call runner should enable it.
ALLOW_TEST_CALL=false
